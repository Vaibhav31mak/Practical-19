@model IEnumerable<string>

@{
    ViewData["Title"] = "Roles";
}

<h2>Roles</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create Role</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-roleName="@role" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-roleName="@role" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
